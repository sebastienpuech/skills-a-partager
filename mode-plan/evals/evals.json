{
  "version": "1.0",
  "description": "Golden cases deterministes pour mode-plan v3.3+. Test des scripts Python sur fixtures synthetiques (dont 4e angle harnais + gate C10). 100% reproductible, 0 LLM, < 5 secondes.",
  "cases": [
    {
      "id": "sd_clean_passes",
      "script": "self_diagnosis.py",
      "fixture_dir": "fixtures/sd_clean",
      "args": ["--type=app"],
      "expected": { "exit_code": 0, "json_match": {"status": "PASS", "checks_run": 9} }
    },
    {
      "id": "sd_placeholder_detected",
      "script": "self_diagnosis.py",
      "fixture_dir": "fixtures/sd_placeholder",
      "args": ["--type=app"],
      "expected": { "exit_code": 1, "json_match": {"status": "FAIL"}, "failure_includes_substring": "C3" }
    },
    {
      "id": "sd_skill_memory_missing",
      "script": "self_diagnosis.py",
      "fixture_dir": "fixtures/sd_skill_no_memory",
      "args": ["--type=skill", "--memory=complet"],
      "expected": { "exit_code": 1, "json_match": {"status": "FAIL"}, "failure_includes_substring": "C4" }
    },
    {
      "id": "align_3_critiques_no_doublon",
      "script": "align_critiques.py",
      "fixture_dir": "fixtures/align_3_critiques",
      "args": [],
      "expected": {
        "exit_code": 0,
        "side_effect_file": "aligned_critiques.json",
        "side_effect_json_match": { "score_global_pondere": 7.0, "statistiques.total_critiques": 3, "doublons_detectes.length": 0 }
      }
    },
    {
      "id": "align_with_doublons_detected",
      "script": "align_critiques.py",
      "fixture_dir": "fixtures/align_with_doublons",
      "args": [],
      "expected": {
        "exit_code": 0,
        "side_effect_file": "aligned_critiques.json",
        "side_effect_json_match": { "statistiques.total_critiques": 2, "doublons_detectes.length": 1 }
      }
    },
    {
      "id": "regression_no_overlap_passes",
      "script": "check_regression.py",
      "fixture_dir": "fixtures/regression_no_overlap",
      "args": [],
      "expected": { "exit_code": 0, "json_match": {"status": "PASS", "alerts_count": 0} }
    },
    {
      "id": "regression_with_overlap_detected",
      "script": "check_regression.py",
      "fixture_dir": "fixtures/regression_with_overlap",
      "args": [],
      "expected": { "exit_code": 1, "json_match": {"status": "FAIL"}, "json_path_min": {"alerts_count": 1} }
    },
    {
      "id": "convergence_continue_round_1",
      "script": "check_convergence.py",
      "fixture_dir": "fixtures/convergence_continue",
      "args": ["--max-iterations=3", "--threshold=8.0"],
      "expected": { "exit_code": 0, "json_match": {"decision.decision": "CONTINUE"} }
    },
    {
      "id": "convergence_converged_round_2",
      "script": "check_convergence.py",
      "fixture_dir": "fixtures/convergence_converged",
      "args": ["--max-iterations=3", "--threshold=8.0"],
      "expected": { "exit_code": 0, "json_match": {"decision.decision": "CONVERGED"} }
    },
    {
      "id": "align_4_critiques_harnais",
      "script": "align_critiques.py",
      "fixture_dir": "fixtures/align_4_critiques",
      "args": [],
      "expected": {
        "exit_code": 0,
        "side_effect_file": "aligned_critiques.json",
        "side_effect_json_match": { "score_global_pondere": 6.6, "statistiques.total_critiques": 4, "statistiques.par_angle.harnais": 1, "doublons_detectes.length": 0 }
      }
    },
    {
      "id": "sd_harness_missing_detected",
      "script": "self_diagnosis.py",
      "fixture_dir": "fixtures/sd_harness_missing",
      "args": ["--type=app", "--harness=on"],
      "expected": { "exit_code": 1, "json_match": {"status": "FAIL", "checks_run": 10}, "failure_includes_substring": "C10" }
    },
    {
      "id": "sd_skill_no_autoimprove_detected",
      "script": "self_diagnosis.py",
      "fixture_dir": "fixtures/sd_skill_no_autoimprove",
      "args": ["--type=skill", "--memory=complet", "--autoimprove=on"],
      "expected": { "exit_code": 1, "json_match": {"status": "FAIL", "checks_run": 10}, "failure_includes_substring": "C11" }
    },
    {
      "id": "sd_skill_autoimprove_ok_passes",
      "script": "self_diagnosis.py",
      "fixture_dir": "fixtures/sd_skill_autoimprove_ok",
      "args": ["--type=skill", "--memory=complet", "--autoimprove=on"],
      "expected": { "exit_code": 0, "json_match": {"status": "PASS", "checks_run": 10} }
    },
    {
      "id": "sd_no_handoff_detected",
      "script": "self_diagnosis.py",
      "fixture_dir": "fixtures/sd_clean",
      "args": ["--type=app", "--handoff=on"],
      "expected": { "exit_code": 1, "json_match": {"status": "FAIL", "checks_run": 10}, "failure_includes_substring": "C12" }
    },
    {
      "id": "sd_handoff_ok_passes",
      "script": "self_diagnosis.py",
      "fixture_dir": "fixtures/sd_handoff_ok",
      "args": ["--type=app", "--handoff=on"],
      "expected": { "exit_code": 0, "json_match": {"status": "PASS", "checks_run": 10} }
    }
  ]
}
